{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiflow.dev/schema/app_config.schema.json",
  "title": "ForceUpdateConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "min_version",
    "recommended_version",
    "maintenance_mode",
    "message_key"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "min_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "recommended_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "maintenance_mode": {
      "type": "boolean"
    },
    "message_key": {
      "type": "string",
      "minLength": 1
    },
    "message_override": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "ja"],
          "properties": {
            "en": { "type": "string", "minLength": 1 },
            "ja": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "update_url": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^https?://" }
      ]
    }
  }
}
